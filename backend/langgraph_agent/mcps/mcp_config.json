{
  "mcpServers": {
    "dataflow": {
      "command": "python",
      "args": [
        "D:/Projects/LLM/Agentic-Base-React/backend/langgraph_agent/mcps/local_servers/dataflow.py"
      ],
      "transport": "stdio"
    },
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "${MCP_FILESYSTEM_DIR}"
      ],
      "transport": "stdio"
    },
    "git": {
      "command": "uvx",
      "args": ["mcp-server-git"],
      "transport": "stdio"
    },
    "duckduckgo": {
      "command": "docker",
      "args": ["run", "-i", "--rm", "mcp/duckduckgo"],
      "transport": "stdio"
    }
  }
}
